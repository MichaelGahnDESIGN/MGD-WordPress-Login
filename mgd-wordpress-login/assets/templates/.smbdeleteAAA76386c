/* Sunset - fließender Verlauf + atmende Sonne */
.mgd-t-sunset .mgd-login-bg { background: linear-gradient(160deg, var(--mgd-bg1), var(--mgd-bg2), var(--mgd-accent), var(--mgd-bg2)); background-size: 300% 300%; animation: mgd-su-flow calc(26s / var(--mgd-speed)) ease-in-out infinite; }
@keyframes mgd-su-flow { 0%, 100% { background-position: 0% 30%; } 50% { background-position: 100% 70%; } }
.mgd-t-sunset .mgd-login-bg > span:nth-child(1) { left: 50%; bottom: -22vmin; width: 62vmin; height: 62vmin; margin-left: -31vmin; border-radius: 50%; background: radial-gradient(circle at 50% 40%, #fff3c4, var(--mgd-accent) 62%, transparent 72%); filter: blur(2px); animation: mgd-su-sun calc(9s / var(--mgd-speed)) ease-in-out infinite alternate; }
.mgd-t-sunset .mgd-login-bg > span:nth-child(2), .mgd-t-sunset .mgd-login-bg > span:nth-child(3) { height: 10vmin; border-radius: 999px; background: rgba(255, 255, 255, .16); filter: blur(14px); }
.mgd-t-sunset .mgd-login-bg > span:nth-child(2) { width: 46vmin; left: 6%; top: 18%; animation: mgd-su-cloud calc(30s / var(--mgd-speed)) ease-in-out infinite alternate; }
.mgd-t-sunset .mgd-login-bg > span:nth-child(3) { width: 34vmin; right: 8%; top: 34%; animation: mgd-su-cloud calc(38s / var(--mgd-speed)) ease-in-out infinite alternate-reverse; }
@keyframes mgd-su-sun { to { transform: translateY(-4vmin) scale(1.08); filter: blur(5px); } }
@keyframes mgd-su-cloud { to { transform: translateX(14vmin); } }
body.mgd-t-sunset #login form { border-color: rgba(255, 255, 255, .28); }
